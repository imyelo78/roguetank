[Unit]
Description=Roguetank game server (Steel Assault)
Documentation=https://github.com/imyelo78/roguetank
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 用普通用户跑：游戏服务只需读代码、写 .data，没有任何理由给 root
User=roguetank
Group=roguetank
WorkingDirectory=/opt/roguetank

Environment=NODE_ENV=production
# 阿里云 + 域名的标准形态：Node 只监听回环，公网流量一律经 Nginx（443 TLS + 限流）
# 直接监听 0.0.0.0 会绕过 HTTPS 和限流，安全组放行 5173 就等于开后门
Environment=HOST=127.0.0.1
Environment=PORT=5173

ExecStart=/usr/bin/env node server.mjs

# 崩溃自动拉起。10 秒内连崩 5 次就先停下，避免疯狂重启刷日志
Restart=always
RestartSec=2
StartLimitIntervalSec=10
StartLimitBurst=5

# 优雅退出：server.mjs 收到 SIGTERM 会给房间里的人发 1012 关闭帧再退出。
# TimeoutStopSec 必须大于内部的 1.5s 收尾时间
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=roguetank

# ---- 安全加固（不影响功能）----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/roguetank/.data
# 世界模拟在内存里跑满 CPU 是正常的，这里只兜内存上限防泄漏
MemoryMax=1G

[Install]
WantedBy=multi-user.target
